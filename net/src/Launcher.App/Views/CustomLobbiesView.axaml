<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.App.ViewModels"
             xmlns:v="using:Launcher.App.Views"
             xmlns:c="using:Launcher.App.Controls"
             x:Class="Launcher.App.Views.CustomLobbiesView"
             x:DataType="vm:CustomLobbiesViewModel"
             x:Name="Root">
  <!-- Play's Custom lobbies page (direction D), two faces. The browser: a table of the lobbies (a lock where one has
       a password, its name, its host, the players of its room, its stage, the rules that differ from Quick Play's),
       a row pressed to join; a locked row asks for the password first, in a strip over the table. Create beside the
       table's head. Create: a line with its title and Back (where the lobby page has Leave); the modes to pick from,
       then the name, the password and the mode's settings in a rules panel with CREATE at its foot, and the lobby's
       own settings beside it. A fixed course opens the course picker in the settings' place. -->
  <UserControl.Styles>
    <!-- the create face's modes: rows, not the theme's list items -->
    <Style Selector="ListBox.modes">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.modes ListBoxItem">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.modes ListBoxItem /template/ ContentPresenter, ListBox.modes ListBoxItem:pointerover /template/ ContentPresenter, ListBox.modes ListBoxItem:selected /template/ ContentPresenter, ListBox.modes ListBoxItem:focus-visible /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TextBlock.grouphead">
      <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
    </Style>
    <Style Selector="Path.lock">
      <Setter Property="Fill" Value="{StaticResource DimBrush}" />
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Data" Value="M2,7 L12,7 L12,15 L2,15 Z M3.6,7 L3.6,5 C3.6,1.6 10.4,1.6 10.4,5 L10.4,7 L8.8,7 L8.8,5 C8.8,3.4 5.2,3.4 5.2,5 L5.2,7 Z" />
    </Style>
    <Style Selector="TextBlock.racing">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <!-- The browser -->
    <StackPanel Spacing="12" IsVisible="{Binding Browsing}">
      <Grid ColumnDefinitions="*,Auto" Height="40">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Classes="dim" Text="{Binding Status}" VerticalAlignment="Center"
                     IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Grid Classes="warnline" ColumnDefinitions="Auto,*" Name="Notice"
                IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Path Classes="warnmark" />
            <TextBlock Grid.Column="1" Text="{Binding Notice}" />
          </Grid>
        </StackPanel>
        <Button Grid.Column="1" Name="CreateButton" Classes="primary" c:PadNav.Main="True" Content="Create"
                Command="{Binding ShowCreateCommand}" IsVisible="{Binding !InQuickPlay}" />
      </Grid>

      <!-- In Quick Play: nothing to list until it is left -->
      <Border Classes="row last" IsVisible="{Binding InQuickPlay}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="In Quick Play" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="secondary" Content="Leave Quick Play" Command="{Binding LeaveQuickPlayCommand}" />
        </Grid>
      </Border>

      <!-- A locked lobby's password -->
      <c:Plate Name="PasswordStrip" Shape="Chamfer" Background="{StaticResource WellBrush}" Padding="16,12" IsVisible="{Binding Asking}">
        <Grid ColumnDefinitions="Auto,*,Auto,8,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
            <Path Classes="lock" Fill="{StaticResource TextBrush}" />
            <TextBlock Classes="strong" Text="{Binding AskingFor.Name}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBox Grid.Column="1" Name="PasswordBox" Classes="field" Text="{Binding Password}" PasswordChar="•" MaxLength="64"
                   PlaceholderText="Password" AutomationProperties.Name="Password" Margin="0,0,12,0" />
          <Button Grid.Column="2" Name="JoinLocked" Classes="primary" Content="Join" Command="{Binding JoinLockedCommand}" IsDefault="True" />
          <Button Grid.Column="4" Classes="secondary" Content="Cancel" Command="{Binding CancelPasswordCommand}" />
        </Grid>
      </c:Plate>

      <StackPanel IsVisible="{Binding !InQuickPlay}">
        <Border Classes="rowhead">
          <Grid ColumnDefinitions="24,2*,120,80,80,3*">
            <TextBlock Grid.Column="1" Classes="colhead" Text="LOBBY" LetterSpacing="1" />
            <TextBlock Grid.Column="2" Classes="colhead" Text="HOST" LetterSpacing="1" Margin="12,0,0,0" />
            <TextBlock Grid.Column="3" Classes="colhead" Text="PLAYERS" LetterSpacing="1" Margin="12,0,0,0" />
            <TextBlock Grid.Column="4" Classes="colhead" Text="NOW" LetterSpacing="1" Margin="12,0,0,0" />
            <TextBlock Grid.Column="5" Classes="colhead" Text="RULES" LetterSpacing="1" Margin="12,0,0,0" />
          </Grid>
        </Border>
        <ItemsControl Name="LobbyList" ItemsSource="{Binding Rows}" c:Motion.Stagger="True">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CustomLobbyRow">
              <Button Classes="plain lobbyrow" AutomationProperties.Name="{Binding Name}"
                      Command="{Binding #Root.((vm:CustomLobbiesViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
                <Border Classes="row hover">
                  <Grid ColumnDefinitions="24,2*,120,80,80,3*">
                    <Path Classes="lock" HorizontalAlignment="Left" IsVisible="{Binding Locked}" />
                    <TextBlock Grid.Column="1" Classes="strong" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Host}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="{Binding Count}" Margin="12,0,0,0" FontFeatures="tnum" />
                    <TextBlock Grid.Column="4" Text="{Binding Stage}" Margin="12,0,0,0" Classes.racing="{Binding Racing}" />
                    <TextBlock Grid.Column="5" Classes="dim" Text="{Binding Rules}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="row last" IsVisible="{Binding NoLobbies}">
          <TextBlock Classes="dim" Text="No lobbies yet" />
        </Border>
      </StackPanel>
    </StackPanel>

    <!-- Create: pick a mode, then its settings. The modes the server lists (Quick Play's rules first, then with each stat
         pack, then the others) and From file… for the host's own; beside them the name, the password and the chosen
         mode's settings with CREATE at their foot, and the lobby's own settings. A fixed course opens the course picker
         in the settings' place. -->
    <Grid RowDefinitions="Auto,*" IsVisible="{Binding Creating}" c:Motion.Reveal="True">
      <!-- the line: the face's title, and at its end the way back, where the lobby page has its Leave -->
      <Grid Name="CreateLine" ColumnDefinitions="*,Auto" Height="32" Margin="0,0,0,16">
        <TextBlock Classes="display d20" Text="NEW LOBBY" VerticalAlignment="Center" />
        <Button Grid.Column="1" Name="Back" Classes="secondary surface" Content="Back" Command="{Binding BackCommand}" />
      </Grid>
      <Grid Grid.Row="1" ColumnDefinitions="344,16,*">
        <!-- the modes: a row each, its line of what it is under its name; the chosen one lit with a mark at its edge -->
        <StackPanel Spacing="12">
          <c:Plate Shape="Chamfer" Background="{StaticResource WellBrush}" Padding="16,8,16,16">
            <StackPanel Spacing="4">
              <TextBlock Classes="caps grouphead" Text="MODE" Margin="0,4,0,2" />
              <ListBox Name="ModeList" Classes="modes" ItemsSource="{Binding Editor.ModeRow.Choices}"
                       SelectedIndex="{Binding Editor.ModeRow.Selected}" AutomationProperties.Name="Mode">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ModeChoice">
                    <Border Classes="row hover" Classes.on="{Binding $parent[ListBoxItem].IsSelected}" Padding="0">
                      <Grid ColumnDefinitions="3,*">
                        <Border Background="{StaticResource AccentBrush}" IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                        <StackPanel Grid.Column="1" Margin="10,8" Spacing="2">
                          <TextBlock Classes="strong" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="dim" Text="{Binding About}" TextWrapping="Wrap" IsVisible="{Binding HasAbout}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Name="ModeFromFile" Classes="link" Content="From file…" HorizontalAlignment="Left" Margin="0,8,0,0"
                      Click="OnModeFromFile" AutomationProperties.Name="A mode from a file" />
            </StackPanel>
          </c:Plate>
          <Grid Classes="warnline" ColumnDefinitions="Auto,*"
                IsVisible="{Binding Editor.ModeRow.HasNote, FallbackValue=False}">
            <Path Classes="warnmark" />
            <TextBlock Grid.Column="1" Text="{Binding Editor.ModeRow.Note}" TextWrapping="Wrap" />
          </Grid>
        </StackPanel>
        <Panel Grid.Column="2">
          <Grid ColumnDefinitions="*,16,*" IsVisible="{Binding RulePanelsShown}">
            <StackPanel Spacing="12" VerticalAlignment="Top">
              <c:RulesPanel Name="CreatePanel" Groups="{Binding Editor.CreateGroups}" Action="CREATE" ActionCommand="{Binding CreateCommand}" />
              <Grid Classes="warnline" ColumnDefinitions="Auto,*"
                    IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Path Classes="warnmark" />
                <TextBlock Grid.Column="1" Text="{Binding Notice}" TextWrapping="Wrap" />
              </Grid>
            </StackPanel>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
              <c:RulesPanel Name="LobbyPanel" Groups="{Binding RuleGroups}" VerticalAlignment="Top" />
            </ScrollViewer>
          </Grid>
          <!-- a fixed course: the course picker in the settings' place, a course pressed is the lobby's -->
          <StackPanel Name="CoursePane" Spacing="12" IsVisible="{Binding PickerShown}">
            <Grid ColumnDefinitions="*,Auto" Height="32">
              <TextBlock Classes="display d20" Text="CHOOSE THE COURSE" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="secondary surface" Content="Done" Command="{Binding Editor.CourseRow.ClosePickerCommand}" />
            </Grid>
            <c:CoursePicker DataContext="{Binding Editor.CourseRow.Picker}" />
          </StackPanel>
        </Panel>
      </Grid>
    </Grid>
  </Panel>
</UserControl>
