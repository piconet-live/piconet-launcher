<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.App.ViewModels"
             xmlns:nx="using:Launcher.App.ViewModels.NextUi"
             xmlns:v="using:Launcher.App.Views"
             xmlns:nxv="using:Launcher.App.Views.NextUi"
             xmlns:c="using:Launcher.App.Controls"
             xmlns:n="using:Launcher.App.Controls.NextUi"
             x:Class="Launcher.App.Views.NextUi.FirstStartView"
             x:DataType="vm:DiscViewModel">
  <!-- The redesigned first start (FirstStartViewModel): three marks, the step's eyebrow, title and line; 1 the disc
       image picked and checked, the game prepared from it once (the stage, the bar and Cancel), "Played before? Bring
       over an older copy", and every sentence the preparation says when it does not end ready; 2 the name, changed
       on the keyboard on the screen; 3 the controller, its buttons lit as they are pressed. Next (Start) and Back; at
       the end Let's race. -->
  <Grid Name="PagePanel" x:DataType="nx:FirstStartViewModel" DataContext="{Binding $parent[nxv:FirstStartView].Page}"
        HorizontalAlignment="Center" VerticalAlignment="Center" Width="760">
    <StackPanel Spacing="14">
      <ItemsControl Name="Marks" ItemsSource="{Binding Marks}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:Boolean">
            <Border Classes="stepmark" Classes.lit="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="eyebrow" FontSize="14" Text="{Binding Eyebrow, Converter={x:Static v:UpperText.Instance}}" />
      <TextBlock Name="Title" Classes="heading" FontSize="60" LineHeight="64" RenderTransform="skewX(-10deg)" RenderTransformOrigin="0%,100%"
                 Text="{Binding Title, Converter={x:Static v:UpperText.Instance}}" />
      <TextBlock Classes="lead" FontSize="18" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Text="{Binding Line}" />

      <!-- 1: the disc image, and the game prepared from it -->
      <StackPanel Spacing="10" Margin="0,10,0,0" IsVisible="{Binding OnDiscStep}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Name="ChooseDisc" Classes="soft" Height="56" Padding="22,0" Click="OnChooseDisc" IsEnabled="{Binding Disc.Idle}"
                  AutomationProperties.Name="Choose the disc image">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Viewbox Width="20" Height="20">
                <Canvas Width="24" Height="24">
                  <Path Classes="stroke" Data="M12 3.5A8.5 8.5 0 1 1 12 20.5A8.5 8.5 0 1 1 12 3.5ZM12 10A2 2 0 1 1 12 14A2 2 0 1 1 12 10Z" StrokeThickness="2" />
                </Canvas>
              </Viewbox>
              <TextBlock VerticalAlignment="Center" Text="{Binding Disc.Path, Converter={x:Static nxv:DiscWordsOf.Instance}}" />
            </StackPanel>
          </Button>
          <Button Name="BringOver" Classes="soft" Height="56" Padding="22,0" Click="OnBringOver" Content="Played before? Bring over an older copy"
                  IsEnabled="{Binding Disc.Move.Idle}" AutomationProperties.Name="Bring over an older copy">
            <Button.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="Disc.Idle" />
                <Binding Path="Disc.Move.Offered" />
              </MultiBinding>
            </Button.IsVisible>
          </Button>
        </StackPanel>
        <TextBlock Classes="quiet" FontSize="15" TextWrapping="Wrap" Text="{Binding Disc.Move.Text}"
                   IsVisible="{Binding Disc.Move.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <!-- the image checked, or what is wrong with it -->
        <TextBlock Name="DiscStatus" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource NextAccentBrush}" Text="{Binding Disc.Status}"
                   IsVisible="{Binding Disc.Verified}" />
        <TextBlock Name="DiscWrong" FontSize="16" TextWrapping="Wrap" Foreground="{StaticResource NextDangerBrush}" Text="{Binding Disc.Status}"
                   IsVisible="{Binding Disc.Wrong}" />
        <!-- the preparation: its stage, how far, the bar, Cancel -->
        <StackPanel Name="Preparing" Spacing="8" IsVisible="{Binding Disc.Preparing}" MaxWidth="640" HorizontalAlignment="Left">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Name="Stage" FontWeight="Bold" LetterSpacing="1.1" Text="{Binding Disc.Stage}" />
            <TextBlock Grid.Column="1" Classes="quiet" FontFeatures="tnum" Margin="0,0,14,0" Text="{Binding Disc.Size}" />
            <TextBlock Grid.Column="2" FontWeight="Bold" FontFeatures="tnum" Text="{Binding Disc.Percent}" />
          </Grid>
          <ProgressBar Name="Bar" Minimum="0" Maximum="1" Width="640" Value="{Binding Disc.Fraction}" AutomationProperties.Name="Preparing the game's files" />
          <TextBlock Classes="quiet" Text="Preparing the game. This happens only once." />
          <Button Name="Cancel" Classes="soft" HorizontalAlignment="Left" Content="Cancel" Command="{Binding Disc.CancelCommand}" IsEnabled="{Binding Disc.CanStop}"
                  AutomationProperties.Name="Cancel the preparation" />
        </StackPanel>
        <TextBlock Name="Ready" FontSize="16" Foreground="{StaticResource NextAccentBrush}" Text="The game is ready." IsVisible="{Binding GameReady}" />
        <TextBlock Name="Said" FontSize="15" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Foreground="{StaticResource NextDevBrush}"
                   Text="{Binding Disc.SaidLabel}" ToolTip.Tip="{Binding Disc.Said}"
                   IsVisible="{Binding Disc.Said, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Name="Notice" FontSize="15" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Foreground="{StaticResource NextDevBrush}"
                   Text="{Binding Disc.Notice}" IsVisible="{Binding Disc.Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <!-- 2: the name -->
      <Button Name="ChangeName" Classes="card c18" Height="96" Width="560" HorizontalAlignment="Left" Padding="26,0" Margin="0,10,0,0"
              Command="{Binding ChangeNameCommand}" IsVisible="{Binding OnNameStep}" AutomationProperties.Name="Your name: change it">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Name="NameShown" Classes="heading" FontSize="40" LineHeight="44" VerticalAlignment="Center" RenderTransform="skewX(-10deg)"
                     Text="{Binding Account.Name}" />
          <TextBlock Grid.Column="1" Classes="quiet" FontSize="17" VerticalAlignment="Center" Text="Change" />
        </Grid>
      </Button>

      <!-- 3: the controller, its buttons lit as they are pressed -->
      <StackPanel Spacing="8" Margin="0,10,0,0" IsVisible="{Binding OnPadStep}">
        <n:Chamfer Classes="plate" Width="560" HorizontalAlignment="Left">
          <Panel Height="250" Margin="20,10">
            <c:PadOverlay Name="PadPicture" Pad="{Binding Controller.PadShown}" />
          </Panel>
        </n:Chamfer>
        <TextBlock Classes="quiet" FontSize="15" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Text="{Binding Controller.PadNote}"
                   IsVisible="{Binding Controller.PadNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <!-- Next (Let's race), and Back -->
      <StackPanel Orientation="Horizontal" Spacing="14" Margin="4,18,0,0">
        <Button Name="Next" Classes="main" Width="260" Content="{Binding NextText}" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}"
                c:PadNav.Main="True" AutomationProperties.Name="{Binding NextText}" />
        <Button Name="Back" Classes="soft" Height="56" Width="140" Content="Back" Command="{Binding BackCommand}" IsVisible="{Binding CanBack}"
                AutomationProperties.Name="Back a step" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
