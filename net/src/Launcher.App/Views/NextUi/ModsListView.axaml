<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Launcher.App.Controls"
             xmlns:vm="using:Launcher.App.ViewModels"
             xmlns:v="using:Launcher.App.Views"
             xmlns:nxv="using:Launcher.App.Views.NextUi"
             xmlns:n="using:Launcher.App.Controls.NextUi"
             x:Class="Launcher.App.Views.NextUi.ModsListView"
             x:DataType="vm:ModsViewModel">
  <!-- More › Mods (the classic page's view model: ModsViewModel): "Import…" (a .zip or a .7z) and "Folder…"; while one
       is imported, its bar and Cancel; a mod of several parts asks which first (its tree); then the mods in their
       order, a row each with its place, its picture, its name, what of it is not used online, and its switch;
       pressed, its panel (on, the order, its stat pack, its parts, Remove). -->
  <Grid Margin="14,8,0,8" RowDefinitions="Auto,Auto,*,Auto">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Classes="eyebrow" FontSize="14" Text="MORE" />
        <TextBlock Name="Title" Classes="heading" FontSize="52" LineHeight="56" RenderTransform="skewX(-10deg)" RenderTransformOrigin="0%,100%"
                   Text="MODS" />
        <TextBlock Classes="lead" Text="Mods on top take priority. Changes start with the next game." />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom" Margin="0,0,16,4" IsEnabled="{Binding Idle}">
        <Button Name="Import" Classes="soft" Content="Import…" Click="OnImportFile" AutomationProperties.Name="Import a mod from a file" />
        <Button Name="ImportFolder" Classes="soft" Content="Folder…" Click="OnImportFolder" AutomationProperties.Name="Import a mod from a folder" />
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1" Spacing="8" Margin="0,12,16,8">
      <TextBlock Name="Notice" TextWrapping="Wrap" Foreground="{StaticResource NextDevBrush}" Text="{Binding Notice}"
                 IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <!-- an import under way: its bar, and Cancel -->
      <n:Chamfer Name="Importing" Classes="plate" IsVisible="{Binding Importing}">
        <Grid Margin="20,14" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
          <TextBlock FontWeight="SemiBold" Text="{Binding ImportName, StringFormat='Importing {0}'}" />
          <ProgressBar Grid.Row="1" Margin="0,10,16,0" Minimum="0" Maximum="1" Value="{Binding Fraction}" />
          <Button Grid.Column="1" Grid.RowSpan="2" Classes="soft" Content="Cancel" Command="{Binding CancelImportCommand}" AutomationProperties.Name="Cancel the import" />
        </Grid>
      </n:Chamfer>
      <!-- a mod of several parts: which of them, first -->
      <n:Chamfer Name="Choosing" Classes="plate" IsVisible="{Binding Choosing}">
        <StackPanel Margin="20,16" Spacing="10">
          <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding ImportName, StringFormat='Which parts of {0}?'}" />
          <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
            <nxv:ModTreeList DataContext="{Binding Choice}" />
          </ScrollViewer>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Classes="main" Content="IMPORT" Command="{Binding ImportChosenCommand}" AutomationProperties.Name="Import the parts ticked" />
            <Button Classes="soft" Height="56" Content="Cancel" Command="{Binding CancelImportCommand}" AutomationProperties.Name="Cancel" />
          </StackPanel>
        </StackPanel>
      </n:Chamfer>
    </StackPanel>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="4,4,16,12">
        <TextBlock Name="NoMods" Classes="quiet" FontSize="17" Text="No mods. Import one to start." IsVisible="{Binding NoCards}" />
        <ItemsControl Name="ModRows" c:PadNav.Home="True" ItemsSource="{Binding Cards}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ModCard">
              <Button Classes="line" Height="68" Margin="0,0,0,8" Padding="14,0,16,0"
                      Command="{Binding $parent[nxv:NextShell].((vm:MainViewModel)DataContext).Shell.OpenModCommand, FallbackValue={x:Null}}"
                      CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='{}{0}: options'}">
                <Grid ColumnDefinitions="36,Auto,*,Auto">
                  <TextBlock Classes="rank" VerticalAlignment="Center" Text="{Binding Rank}" />
                  <Border Grid.Column="1" Width="72" Height="44" CornerRadius="3" ClipToBounds="True" Margin="0,0,14,0" Background="{StaticResource NextRaisedBrush}">
                    <Panel>
                      <Image Source="{Binding Picture}" Stretch="UniformToFill" IsVisible="{Binding HasPicture}" />
                      <TextBlock FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Initial}"
                                 IsVisible="{Binding !HasPicture}" />
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                    <TextBlock FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                    <!-- Developer mode: the mod's id (its folder) -->
                    <TextBlock Classes="devmono" Text="{Binding Id}"
                               IsVisible="{Binding $parent[nxv:NextShell].((vm:MainViewModel)DataContext).DeveloperMode, FallbackValue=False}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasTags}">
                      <Border Classes="flag quietflag" IsVisible="{Binding SinglePlayer}" ToolTip.Tip="{Binding SinglePlayerWhy}">
                        <TextBlock Text="SINGLE PLAYER" />
                      </Border>
                      <Border Classes="flag quietflag" IsVisible="{Binding CodeNotUsed}" ToolTip.Tip="{Binding CodeWhy}">
                        <TextBlock Text="CODE NOT USED" />
                      </Border>
                    </StackPanel>
                  </StackPanel>
                  <Border Grid.Column="3" Classes="switch" Classes.on="{Binding On}" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Classes="knob" />
                  </Border>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <TextBlock Grid.Row="3" Classes="quiet" FontSize="14" Margin="6,8,0,0" Text="Mods are made by players. Only add the ones you trust." />
  </Grid>
</UserControl>
