<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.App.ViewModels"
             xmlns:v="using:Launcher.App.Views"
             xmlns:nxv="using:Launcher.App.Views.NextUi"
             xmlns:c="using:Launcher.App.Controls"
             xmlns:n="using:Launcher.App.Controls.NextUi"
             x:Class="Launcher.App.Views.NextUi.CustomListView"
             x:DataType="vm:CustomLobbiesViewModel">
  <!-- The redesigned interface's custom lobbies (the classic page's view model: CustomLobbiesViewModel), two faces.
       The list: a row a lobby (a lock where it has a password, its name, its host and the rules that differ from
       Quick Play's, how full it is, what it is doing), a press joins it, asking for the password first; the page's
       main action Create lobby, and in Quick Play "Leave Quick Play" in its place. Create: the rules as an option page
       (RulesPageView, the shell's CreateRules). -->
  <Panel>
    <Grid Margin="14,8,0,8" RowDefinitions="Auto,*,Auto" IsVisible="{Binding Browsing}">
      <Grid ColumnDefinitions="*,24,Auto">
        <StackPanel Spacing="4">
          <TextBlock Classes="eyebrow" FontSize="14" Text="PLAY" />
          <TextBlock Name="Title" Classes="heading" FontSize="52" LineHeight="56" Margin="0,0,0,8" RenderTransform="skewX(-10deg)"
                     RenderTransformOrigin="0%,100%" Text="CUSTOM LOBBIES" />
          <Panel>
            <TextBlock Classes="lead" Text="Your rules. Invite friends with a password." IsVisible="{Binding !InQuickPlay}" />
            <TextBlock Classes="lead" Text="You are in Quick Play. Leave it to join one of these." IsVisible="{Binding InQuickPlay}" />
          </Panel>
        </StackPanel>
        <StackPanel Grid.Column="2" Width="300" VerticalAlignment="Top" Spacing="10">
          <Button Name="Create" Classes="main" ToolTip.Tip="Make a lobby with your own rules (Start)" Margin="6,6,6,0" HorizontalAlignment="Stretch" Content="CREATE LOBBY"
                  Command="{Binding ShowCreateCommand}" IsVisible="{Binding !InQuickPlay}" c:PadNav.Main="True"
                  AutomationProperties.Name="Create lobby" />
          <Button Name="LeaveQuickPlay" Classes="soft danger" Height="50" Margin="6,6,6,0" HorizontalAlignment="Stretch"
                  Content="Leave Quick Play" Command="{Binding LeaveQuickPlayCommand}" IsVisible="{Binding InQuickPlay}"
                  AutomationProperties.Name="Leave Quick Play" />
        </StackPanel>
      </Grid>

      <ScrollViewer Grid.Row="1" Margin="0,10,0,0" MaxWidth="900" HorizontalAlignment="Left" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <ItemsControl Name="Rows" c:PadNav.Home="True" ItemsSource="{Binding Rows}" Margin="6,6,12,6" ClipToBounds="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" ClipToBounds="False" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CustomLobbyRow">
              <Button Classes="line" Height="68" Width="860" HorizontalAlignment="Left"
                      Command="{Binding $parent[UserControl].((vm:CustomLobbiesViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}"
                      AutomationProperties.Name="{Binding Name}">
                <Grid ColumnDefinitions="22,*,Auto,Auto,24">
                  <Path Classes="lock" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding Locked}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                    <StackPanel Orientation="Horizontal" Spacing="0">
                      <TextBlock Classes="quiet" FontSize="15" TextTrimming="CharacterEllipsis">
                        <Run Text="Host " /><Run Text="{Binding Host}" />
                      </TextBlock>
                      <TextBlock Classes="quiet" FontSize="15" MaxWidth="520" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasRules}"
                                 Text="{Binding Rules, StringFormat='  ·  {0}'}" />
                    </StackPanel>
                  </StackPanel>
                  <!-- the lobby the player is in says so: pressed, its page (nothing is left or asked) -->
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Name="Yours" Classes="eyebrow" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource NextAccentBrush}"
                               Text="YOUR LOBBY" IsVisible="{Binding Mine}" />
                    <TextBlock FontSize="17" FontFeatures="tnum" VerticalAlignment="Center" Text="{Binding Count}" />
                  </StackPanel>
                  <Border Grid.Column="3" Classes="flag" Classes.live="{Binding Racing}" Classes.quietflag="{Binding !Racing}"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding Stage, Converter={x:Static v:UpperText.Instance}}" />
                  </Border>
                  <Viewbox Grid.Column="4" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                      <Path Classes="stroke" Data="M9 5L16 12L9 19" StrokeThickness="2.4" />
                    </Canvas>
                  </Viewbox>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- under the list: none yet, connecting, or a refusal -->
      <StackPanel Grid.Row="2" Height="52" Margin="6,6,0,0">
        <TextBlock Name="Empty" Classes="quiet" FontSize="15" Text="No lobbies yet. Create one, or check back soon." IsVisible="{Binding NoLobbies}" />
        <TextBlock Classes="quiet" FontSize="15" Text="{Binding Status}" />
        <TextBlock Name="Notice" FontSize="15" Foreground="{StaticResource NextDevBrush}" Text="{Binding Notice}" />
      </StackPanel>
    </Grid>

    <!-- Create: the rules as an option page -->
    <Panel IsVisible="{Binding Creating}">
      <nxv:RulesPageView Name="CreatePage"
                         DataContext="{Binding $parent[nxv:NextShell].((vm:MainViewModel)DataContext).Shell.CreateRules}" />
    </Panel>

    <!-- a locked lobby's password -->
    <Panel Name="PasswordQuestion" IsVisible="{Binding Asking}" c:PadNav.Scope="True">
      <Border Classes="dim" />
      <n:Chamfer Classes="dialog">
        <StackPanel Margin="36" Spacing="12">
          <Border Height="3" Margin="-36,-36,-36,21" Background="{StaticResource NextAccentBrush}" />
          <TextBlock Classes="asks" Text="LOCKED LOBBY" />
          <TextBlock Classes="lead" Text="{Binding AskingFor.Name, FallbackValue=''}" />
          <TextBox Name="PasswordBox" FontSize="17" Margin="0,8,0,0" Text="{Binding Password}" PasswordChar="•" MaxLength="64"
                   PlaceholderText="Password" AutomationProperties.Name="Password" />
          <StackPanel Orientation="Horizontal" Spacing="14" Margin="4,16,0,0">
            <Button Classes="main" Content="JOIN" Command="{Binding JoinLockedCommand}" IsDefault="True" AutomationProperties.Name="Join" />
            <Button Classes="soft" Height="56" Content="Cancel" Command="{Binding CancelPasswordCommand}" AutomationProperties.Name="Cancel" />
          </StackPanel>
        </StackPanel>
      </n:Chamfer>
    </Panel>
  </Panel>
  <UserControl.Styles>
    <Style Selector="Path.lock">
      <Setter Property="Fill" Value="{StaticResource NextDimBrush}" />
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Data" Value="M2,7 L12,7 L12,15 L2,15 Z M3.6,7 L3.6,5 C3.6,1.6 10.4,1.6 10.4,5 L10.4,7 L8.8,7 L8.8,5 C8.8,3.4 5.2,3.4 5.2,5 L5.2,7 Z" />
    </Style>
  </UserControl.Styles>
</UserControl>
