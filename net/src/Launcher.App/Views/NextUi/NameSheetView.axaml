<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nx="using:Launcher.App.ViewModels.NextUi"
             xmlns:v="using:Launcher.App.Views"
             x:Class="Launcher.App.Views.NextUi.NameSheetView"
             x:DataType="nx:NameSheetViewModel">
  <!-- The profile's "Change name": the box, how races will show the name, the room left (or what the game cannot
       draw); Save and Cancel. -->
  <DockPanel Margin="32,28,28,24">
    <StackPanel DockPanel.Dock="Top" Spacing="2">
      <TextBlock Classes="eyebrow" Text="PROFILE" />
      <TextBlock Name="Title" Classes="heading" FontSize="40" LineHeight="44" RenderTransform="skewX(-10deg)" RenderTransformOrigin="0%,100%"
                 Text="YOUR NAME" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="4,16,8,0">
      <Button Name="Save" Classes="main" HorizontalAlignment="Stretch" Content="SAVE" Command="{Binding SaveCommand}"
              IsEnabled="{Binding Account.CanSave}" AutomationProperties.Name="Save the name" />
      <Button Name="Cancel" Classes="soft" HorizontalAlignment="Stretch" Content="Cancel" Command="{Binding CancelCommand}" AutomationProperties.Name="Cancel" />
    </StackPanel>
    <StackPanel Margin="0,20,0,0" Spacing="10">
      <TextBox Name="NameBox" FontSize="18" Text="{Binding Account.Draft}" AutomationProperties.Name="Your name" />
      <TextBlock Name="Under" Classes="quiet" FontSize="14" Text="{Binding Under}" />
      <TextBlock Name="Reads" Classes="lead" TextWrapping="Wrap" Text="{Binding Reads}" />
    </StackPanel>
  </DockPanel>
</UserControl>
