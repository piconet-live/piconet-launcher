<Project Sdk="Microsoft.NET.Sdk">

  <!-- The launcher's logic, without any UI: views can be replaced without touching it. Of the
       server it knows the messages only (Online.Protocol). -->

  <!-- The server stack a copy is made for (StackStamp.cs): -p:ServerStack=NAME -p:StackServer=wss://HOST/ws
       -p:StackKind=test|public, as the private release path passes them for a stack. All three or none: without them
       the build names no stack and has no official server (the player chooses one in Settings). Any of them given
       and not right stops the build (a mistyped stamp would otherwise make a launcher that looks made for a stack
       and has no server). -->
  <PropertyGroup>
    <StackStampGiven Condition="'$(ServerStack)$(StackServer)$(StackKind)' != ''">true</StackStampGiven>
  </PropertyGroup>
  <ItemGroup Condition="'$(StackStampGiven)' == 'true'">
    <AssemblyMetadata Include="ServerStack" Value="$(ServerStack)" />
    <AssemblyMetadata Include="StackServer" Value="$(StackServer)" />
    <AssemblyMetadata Include="StackKind" Value="$(StackKind)" />
  </ItemGroup>
  <Target Name="CheckServerStack" BeforeTargets="BeforeBuild" Condition="'$(StackStampGiven)' == 'true'">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ServerStack)', '^[A-Za-z0-9][A-Za-z0-9._-]*$'))"
           Text="ServerStack '$(ServerStack)' is not a stack's name: a stack's build takes ServerStack, StackServer and StackKind together" />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(StackServer)', '^wss?://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]{1,5})?/[A-Za-z0-9._/-]+$'))"
           Text="StackServer '$(StackServer)' is not a server's address (wss://HOST/ws)" />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(StackKind)', '^(test|public)$'))" Text="StackKind '$(StackKind)' is neither test nor public" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="$(OnlineProtocolProject)" />
  </ItemGroup>

  <!-- The status board between the launcher and a running game (Board/GameBoard.cs): its layout is generated from
       protocol/board.toml (protocol/generate.py) into the view this compiles in; the view reads the mapping through
       a pointer, hence unsafe code (that file and GameBoard.cs only). -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProtocolGenerated)StatusBoard.g.cs" Link="Board/StatusBoard.g.cs" />
    <!-- The replay file's reader (ReplayParts, ReplayFormat), generated by protocol/generate.py from
         protocol/replay.toml, the format's one definition; ReplayFile judges what it reads. -->
    <Compile Include="$(ProtocolGenerated)ReplayFile.g.cs" Link="Files/ReplayFile.g.cs" />
    <!-- The game's launch file's writer (LaunchFile and its parts, LaunchFormat), generated from protocol/launch.toml,
         the file's one definition, which also writes the game's reader; GameLaunchFile fills it. -->
    <Compile Include="$(ProtocolGenerated)LaunchFile.g.cs" Link="Files/LaunchFile.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reads the menu pictures from the player's own disc (nothing from the game is in this repository): piconet-tools'
         library, built from its source (FzgxTools, net/Directory.Build.props). -->
    <ProjectReference Include="$(FzgxTools)src/Fzgx.GameCube/Fzgx.GameCube.csproj" />
  </ItemGroup>
  <Target Name="CheckFzgxTools" BeforeTargets="PrepareForBuild;_GenerateRestoreProjectSpec">
    <Error Condition="'$(FzgxTools)' == '' or !Exists('$(FzgxTools)src/Fzgx.GameCube/Fzgx.GameCube.csproj')"
           Text="no piconet-tools checkout at external/tools (its Fzgx.GameCube is built with the launcher): git submodule update --init, or name one with -p:FzgxTools=FOLDER/" />
  </Target>

  <ItemGroup>
    <!-- Discord's activity status, by local IPC to the player's own Discord (DiscordPresence.cs). -->
    <PackageReference Include="DiscordRichPresence" />
  </ItemGroup>

  <ItemGroup>
    <!-- Which disc the game's files are prepared from (DiscPrep.cs): hashes of named files, one digest, the pins.
         Written by net/tools/DiscPinsWriter from your disc; no game data. -->
    <EmbeddedResource Include="DiscPins.json" LogicalName="Launcher.Core.DiscPins.json" />
  </ItemGroup>

</Project>
